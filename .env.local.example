# ─────────────────────────────────────────────────────────────
# FONTE — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# Aucune de ces valeurs n'est commitée.
# ─────────────────────────────────────────────────────────────

# URL du projet Supabase. Tableau de bord Supabase > Project Settings > API.
# Exposée au navigateur : c'est normal, elle est publique par conception.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Clé anonyme (anon / publishable). Publique, protégée par les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# URL publique du site, utilisée pour les redirections d'authentification
# (confirmation d'email, réinitialisation de mot de passe).
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_ ───

# Clé service_role. Contourne la RLS. Utilisée seulement par les routes
# serveur qui vérifient un code d'accès avant l'inscription et par l'espace
# admin. Si cette clé fuit côté client, toute la base est lisible.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Clés VAPID pour les notifications push (Web Push).
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@exemple.fr"

# Secret partagé avec le Cron Vercel qui déclenche les relances.
# Générer avec : openssl rand -base64 32
CRON_SECRET=""
